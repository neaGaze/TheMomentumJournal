# Supabase (local self-hosted via `supabase start`)
# Browser uses NEXT_PUBLIC_SUPABASE_URL; Next.js server inside Docker uses SUPABASE_INTERNAL_URL.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<paste from `supabase start` output>
SUPABASE_SERVICE_ROLE_KEY=<paste from `supabase start` output>
# Only set when running the Next.js app inside Docker on the same machine as the Supabase stack.
# Leave unset when running `npm run dev` natively — the browser URL works for both.
# SUPABASE_INTERNAL_URL=http://supabase_kong_TheMomentumJournal:8000

# Claude API
ANTHROPIC_API_KEY=sk-ant-your-api-key

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
