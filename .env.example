# Supabase (self-hosted via `supabase start` on the same host as the app)
# NEXT_PUBLIC_SUPABASE_URL must be reachable by the BROWSER.
#   LAN access:    http://<server-lan-ip>:54321
#   Via Cloudflare: https://supabase.yourdomain.com
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<paste from `supabase start` output>
SUPABASE_SERVICE_ROLE_KEY=<paste from `supabase start` output>
# Server-side loopback (set in docker-compose.app.yml; uncomment only to override).
# SUPABASE_INTERNAL_URL=http://127.0.0.1:54321

# Claude API
ANTHROPIC_API_KEY=sk-ant-your-api-key

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
