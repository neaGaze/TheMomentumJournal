# Local Postgres (see docker-compose.yml). Compose overrides the host to `postgres` for the web container.
DATABASE_URL=postgres://momentum:momentum@localhost:5432/momentum

# Auth.js secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Claude API
ANTHROPIC_API_KEY=sk-ant-your-api-key

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set true when served behind a reverse proxy / tunnel (Cloudflare, nginx, Caddy)
# so Auth.js v5 trusts the forwarded host. Compose already sets this for `web`.
# AUTH_TRUST_HOST=true
